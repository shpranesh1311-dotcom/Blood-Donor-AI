# =========================================================
# Blood Donor AI - Environment Configuration
# Copy this file to ".env" and adjust values as needed.
# =========================================================

# Database mode: "sqlite" (default, zero setup) or "postgresql"
DB_MODE=sqlite

# Used only when DB_MODE=sqlite
SQLITE_PATH=./data/processed/blood_donor.db

# Used only when DB_MODE=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blood_donor_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# App secret (demo only - do not use in production)
SECRET_KEY=demo-secret-key-change-me

# Default admin account created on first run (demo only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
